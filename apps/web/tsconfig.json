{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": ["./*"],
      "@repo/core": ["../../packages/core/src/index.ts"],
      "@repo/ui": ["../../packages/ui/src/index.ts"]
    },
    "allowJs": true,
    "noEmit": true,
    "esModuleInterop": true
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules", ".next", "tests"]
}
