{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": [
    "bom1"
  ],
  "services": {
    "web": {
      "root": "apps/web",
      "framework": "nextjs"
    },
    "agents": {
      "root": "services/agents",
      "entrypoint": "main:app"
    }
  },
  "rewrites": [
    {
      "source": "/api/agents(/.*)?",
      "destination": {
        "type": "service",
        "service": "agents"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "type": "service",
        "service": "web"
      }
    }
  ]
}
