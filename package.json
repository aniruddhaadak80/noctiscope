{
  "name": "noctiscope",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "typecheck": "turbo typecheck",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "db:seed": "bun scripts/seed.ts",
    "generate": "bun scripts/generate.ts",
    "loc": "bun scripts/loc-count.mjs",
    "gen:assets": "bun scripts/gen-assets.mjs"
  },
  "devDependencies": {
    "turbo": "^2.5.4",
    "typescript": "^5.7.3",
    "vitest": "^5.0.5",
    "@playwright/test": "^1.64.1",
    "@axe-core/playwright": "^4.14.0",
    "@biomejs/biome": "^2.6.2"
  }
}
